generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("officer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  templates DocumentTemplate[] @relation("TemplateCreator")
  cases     ViolationCase[]    @relation("CaseOfficer")
}

model DocumentTemplate {
  id               String    @id @default(cuid())
  orderNumber      Int       @unique
  name             String
  originalFileName String
  contentHtml      String
  createdById      String
  createdBy        User      @relation("TemplateCreator", fields: [createdById], references: [id])
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  variables DocumentVariable[]
  cases     ViolationCase[]

  @@index([createdById])
}

model DocumentVariable {
  id              String   @id @default(cuid())
  templateId      String
  template        DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name            String
  dataType        String   @default("nvarchar")
  originalText    String
  placeholderKey  String   @unique
  appearanceCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  caseValues ViolationCaseValue[]

  @@unique([templateId, name])
  @@index([templateId])
}

model ViolationCase {
  id               String    @id @default(cuid())
  templateId       String
  template         DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  officerId        String
  officer          User      @relation("CaseOfficer", fields: [officerId], references: [id])
  caseNumber       String?
  finalContentHtml String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  printedAt        DateTime?

  values ViolationCaseValue[]

  @@index([templateId])
  @@index([officerId])
}

model ViolationCaseValue {
  id         String @id @default(cuid())
  caseId     String
  case       ViolationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  variableId String
  variable   DocumentVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)
  value      String

  @@unique([caseId, variableId])
  @@index([caseId])
  @@index([variableId])
}
