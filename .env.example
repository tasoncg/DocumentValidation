# Postgres connection — Supabase (or any other Postgres host).
# DATABASE_URL: pooled (PgBouncer transaction mode, port 6543) for runtime queries.
# DIRECT_URL:   direct/session mode (port 5432) — Prisma uses this for `db push` / migrations.
DATABASE_URL="postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASS@HOST:5432/postgres"

# openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
